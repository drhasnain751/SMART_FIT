{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "smart_fit_frontend": {
      "root": "Smart_Fit_frontend",
      "framework": "vite"
    },
    "smartfit-backend": {
      "root": "smartfit-backend",
      "framework": "express",
      "entrypoint": "app.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "smartfit-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "smart_fit_frontend"
      }
    }
  ]
}
